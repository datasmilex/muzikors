default_platform(:ios)

platform :ios do
  desc "Build and upload iOS app to App Store Connect / TestFlight"
  lane :release do
    # 1. Connect via App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    # 2. Setup temporary CI keychain
    keychain_name = "ci_keychain"
    keychain_password = "muzikors_ci_password_2026"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    # 3. Retrieve or create Apple Distribution Certificate
    get_certificates(
      api_key: api_key,
      keychain_name: keychain_name,
      keychain_password: keychain_password
    )

    # 4. Retrieve or create App Store Provisioning Profile
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.muzikors.app",
      adhoc: false
    )

    # 5. Build and archive the app
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/out",
      output_name: "Muzikors.ipa"
    )

    # 6. Upload to App Store Connect / TestFlight
    if ENV["UPLOAD_TO_APP_STORE"] == "true"
      upload_to_testflight(
        api_key: api_key,
        ipa: "build/out/Muzikors.ipa",
        skip_waiting_for_build_processing: true
      )
    end
  end
end
